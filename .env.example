# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=cineai
POSTGRES_PASSWORD=cineai_secret
POSTGRES_DB=cineai_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cineai:cineai_secret@postgres:5432/cineai_db

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── TMDb API (optional – leave blank to use MovieLens static data) ────────────
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500

# ─── MLflow ──────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=cineai-recommendations

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Admin ───────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@cineai.com
ADMIN_PASSWORD=Admin@123

# ─── ML Model ────────────────────────────────────────────────────────────────
MODEL_DIR=./models
MIN_RATINGS_FOR_RETRAIN=50
RETRAIN_CHECK_INTERVAL_HOURS=1
